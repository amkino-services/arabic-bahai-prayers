    {
      "id": "temple-announcement",
      "date": "2012-04-21",
      "category": "house_of_worship",
      "summary_ar": "أعلن بيت العدل الأعظم أن تانا واحدة من خمسة تجمعات يجري التشاور بشأن إقامة أول مشارق الأذكار المحلية فيها.",
      "source_ids": [
