  "developments": [
    {
      "id": "temple-announcement",
      "date": "2012-04-21",
      "category": "house_of_worship",
      "summary_ar": "أعلن بيت العدل الأعظم أن باتامبانغ واحدة من خمسة تجمعات يجري التشاور بشأن إقامة أول مشارق الأذكار المحلية فيها.",
      "source_ids": [
        "uhj-ridvan-2012"
      ]
    },
    {
      "id": "design-unveiling",
      "period": "2015",
      "category": "worship_and_service",
      "summary_ar": "عند الكشف عن تصميم مشرق الأذكار برزت في اللقاءات المحلية فكرة اقتران الصلاة بخدمة الإنسانية، ومشاركة الشباب في التعبير عن معنى المعبد في حياتهم.",
      "source_ids": [
        "bwns-design-2015"
      ]
    },
    {
      "id": "groundbreaking",
      "date": "2015-11-14",
      "category": "collective_action",
      "summary_ar": "شارك نحو مئتي شخص من المنطقة في وضع حجر الأساس. وحتى قبل اكتمال البناء، وُصف المشروع بأنه أصبح جزءًا من نسيج الحياة المجتمعية ومشروعًا جماعيًا يحفز السكان.",
      "source_ids": [
        "bwns-groundbreaking-2015"
      ]
    },
    {
      "id": "tree-planting-and-youth",
      "date": "2016-09-12",
      "category": "youth_and_service",
      "summary_ar": "شارك أكثر من 150 شخصًا في يوم لزراعة الأشجار في أرض مشرق الأذكار. وأبرزت التجربة دور الشباب الذين وصفوا الأنشطة المجتمعية بأنها إطار للخدمة وتنمية القدرة على تقديم التربية الأخلاقية للأطفال والناشئة وبناء الوحدة.",
      "source_ids": [
        "bwns-collective-action-2016"
      ]
    },
    {
      "id": "community-service-2017",
      "period": "2017",
      "category": "community_building",
      "summary_ar": "مع تقدم البناء، شارك عدد كبير من سكان المنطقة في خدمة مجتمعاتهم وفي العمل في أرض مشرق الأذكار، مما عكس اتساع روح العمل الجماعي.",
      "source_ids": [
        "bwns-construction-2017"
      ]
    },
    {
      "id": "spiritual-material-education",
      "date": "2017-09-01",
      "category": "capacity_building",
      "summary_ar": "وصفت رسالة بيت العدل الأعظم جهود المؤمنين في كمبوديا في النهوض بالنفوس من خلال التربية الروحية والمادية وتمكين السكان من تنمية قدرتهم على الخدمة، وأشارت إلى أنهم من المجتمعات المتقدمة في ميدان التعلم حول بناء المجتمع.",
      "source_ids": [
        "uhj-dedication-2017"
      ]
    },
    {
      "id": "temple-dedication",
      "date": "2017-09-01",
      "category": "house_of_worship",
      "summary_ar": "افتتح في باتامبانغ أول مشرق أذكار بهائي محلي من المرحلة الجديدة لمشارق الأذكار، بتصميم يستلهم الثقافة الكمبودية ويؤكد وحدة العبادة والخدمة.",
      "source_ids": [
        "uhj-dedication-2017",
        "bwns-inauguration-2017"
      ]
    },
    {
      "id": "open-to-community",
      "period": "2017",
      "category": "unity",
      "summary_ar": "أصبح مشرق الأذكار مكانًا مفتوحًا للسكان من مختلف الخلفيات، بينما أبرزت فعاليات الافتتاح دوره في تعزيز الوحدة والصلاة والتأمل وخدمة الآخرين.",
      "source_ids": [
        "bwns-conference-2017",
        "bwns-inauguration-2017"
      ]
    }
  ],
